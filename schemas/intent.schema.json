{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idd/intent.schema.json",
  "title": "IDD Intent Frontmatter",
  "type": "object",
  "required": ["id", "slug", "status", "parent", "actor", "impact", "owners", "created"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^INT-\\d{4}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "proposed", "accepted", "implemented", "deprecated", "superseded"] },
    "parent": { "type": "string", "pattern": "^VIS-\\d{3}$" },
    "actor": { "type": "string", "minLength": 1 },
    "impact": { "type": "string", "minLength": 1 },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "email" }
    },
    "created": { "type": "string", "format": "date" },
    "supersedes": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^INT-\\d{4}$" }
      ]
    },
    "superseded-by": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^INT-\\d{4}$" }
      ]
    }
  }
}
